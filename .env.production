# Dùng khi `npm run build` (bản deploy).
# Vite NHÚNG giá trị vào bundle lúc BUILD, không đọc lúc chạy
# → đổi URL ở đây thì phải BUILD/DEPLOY lại, restart không ăn thua.
# Host (Vercel/Netlify) đặt biến cùng tên trên dashboard sẽ ĐÈ file này.
VITE_API_BASE_URL=https://furpms-be-1.onrender.com/api
VITE_USE_MOCK_API=false
