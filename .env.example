# ⚠️ BÌNH THƯỜNG KHÔNG CẦN TẠO FILE `.env` NỮA.
# URL API đã set sẵn theo từng môi trường (các file dưới đều đã commit):
#
#   npm run dev          -> .env.development  -> http://localhost:5068/api  (BE chạy trên máy mình)
#   npm run dev:remote   -> .env.remote       -> BE deploy trên Railway     (cho người KHÔNG chạy BE local)
#   npm run build        -> .env.production   -> BE deploy trên Railway     (bản deploy)
#
# Chỉ tạo file riêng khi cần ĐÈ giá trị cho RIÊNG máy mình (không lên git):
#   .env.development.local   -> đè khi chạy `npm run dev`
#   .env.local               -> đè ở mọi mode
#
# Thứ tự ưu tiên của Vite (dưới đè lên trên):
#   .env  <  .env.local  <  .env.[mode]  <  .env.[mode].local
# ⇒ Sửa `.env` mà không thấy tác dụng là do `.env.development` đè lên.
#   Dùng `.env.development.local` thay vì `.env`.

VITE_API_BASE_URL=http://localhost:5068/api
# false = gọi BE thật; true = dùng mock data (không cần BE).
VITE_USE_MOCK_API=false
