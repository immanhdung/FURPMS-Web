# Dùng khi chạy `npm run dev` — BE chạy trên MÁY MÌNH.
# File này ĐƯỢC commit: ai clone về cũng chạy đúng ngay, không phải hỏi nhau URL.
#
# ⚠️ ĐỪNG đổi dòng dưới sang URL của bản deploy. Đổi thì mọi người chạy `npm run dev` đều
# ghi thẳng vào DB THẬT — thử nghiệm, xoá nhầm, seed lung tung đều đổ vào đó.
# Ai không chạy BE local thì dùng `npm run dev:remote` (đọc .env.remote), đúng việc của nó.
VITE_API_BASE_URL=http://localhost:5068/api
VITE_USE_MOCK_API=false
